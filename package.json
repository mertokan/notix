{
  "name": "notix",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first proje notlari / yapilacaklar. Kaynak = duz markdown, AI'lar dogrudan duzenler.",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "repository": "github:mertokan/notix",
  "build": {
    "appId": "com.mertokan.notix",
    "productName": "Notix",
    "files": [
      "electron.js",
      "server.js",
      "store.js",
      "mcp.js",
      "package.json",
      "public/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "mertokan",
      "repo": "notix"
    }
  }
}
